{
  "name": "mexican-train",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Real-time online Mexican Train dominoes. Ephemeral in-memory sessions, share-a-URL joining.",
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "esbuild client/app.ts --bundle --format=esm --target=es2022 --sourcemap --outfile=public/app.js",
    "start": "node dist/server/index.js",
    "dev": "npm run build:client && tsx watch server/index.ts",
    "test": "npm run build:server && node --test dist/test/*.test.js && npm run soak",
    "soak": "node dist/scripts/soak.js",
    "usage": "tsx scripts/usage.ts",
    "og": "tsx scripts/og-image.ts",
    "types": "tsc -p tsconfig.json --noEmit && tsc -p client && tsc -p worker",
    "lint": "eslint .",
    "check": "npm run lint && npm run types && npm test && npm run check:worker",
    "check:worker": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "tf:plan": "terraform -chdir=terraform plan",
    "tf:apply": "terraform -chdir=terraform apply",
    "dev:client": "esbuild client/app.ts --bundle --format=esm --target=es2022 --sourcemap --outfile=public/app.js --watch"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260813.1",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
